#!/bin/bash

# new_version - Helper script to create a new version tag
# Usage: ./scripts/new_version <major|minor>

set -e

# Colors for output
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'

# Print colored status messages
print_status() { echo -e "${1}[${2}]${NC} $3"; }

# Show help
show_help() {
    cat << EOF
Usage: $0 [OPTIONS] <major|minor>

Create a new version tag for the project.

ARGUMENTS:
    major       Increment major version (e.g., v0.2 -> v1.0)
    minor       Increment minor version (e.g., v0.2 -> v0.3)

OPTIONS:
    -h, --help  Show this help message

EXAMPLES:
    $0 minor    # v0.2 -> v0.3
    $0 major    # v0.2 -> v1.0

The script will:
1. Check for uncommitted changes
2. Get the latest version tag
3. Generate the new version
4. Create and push the new tag
EOF
}

# Check for uncommitted changes
check_git_status() {
    if ! git diff-index --quiet HEAD --; then
        print_status "$RED" "ERROR" "Uncommitted changes detected. Please commit or stash them first."
        print_status "$BLUE" "INFO" "Run 'git status' to see uncommitted changes"
        exit 1
    fi
    
    if ! git diff-index --quiet --cached HEAD --; then
        print_status "$RED" "ERROR" "Staged changes detected. Please commit them first."
        exit 1
    fi
    
    print_status "$GREEN" "OK" "Working directory is clean"
}

# Get the latest version tag
get_latest_version() {
    local latest_tag
    latest_tag=$(git tag --sort=-version:refname | head -1)
    
    if [ -z "$latest_tag" ]; then
        echo "v0.0"
        return
    fi
    
    # Validate tag format (v0.1, v1.2, etc.)
    if [[ ! "$latest_tag" =~ ^v[0-9]+\.[0-9]+$ ]]; then
        print_status "$RED" "ERROR" "Latest tag '$latest_tag' doesn't follow v<major>.<minor> format"
        exit 1
    fi
    
    echo "$latest_tag"
}

# Parse version components
parse_version() {
    local version="$1"
    # Remove 'v' prefix and split by '.'
    version=${version#v}
    echo "${version%.*}" "${version#*.}"  # major minor
}

# Generate new version
generate_new_version() {
    local bump_type="$1"
    local current_version="$2"
    
    read -r major minor <<< "$(parse_version "$current_version")"
    
    case "$bump_type" in
        major)
            major=$((major + 1))
            minor=0
            ;;
        minor)
            minor=$((minor + 1))
            ;;
        *)
            print_status "$RED" "ERROR" "Invalid bump type: $bump_type"
            exit 1
            ;;
    esac
    
    echo "v${major}.${minor}"
}

# Create and push tag
create_tag() {
    local new_version="$1"
    local current_branch
    current_branch=$(git branch --show-current)
    
    print_status "$BLUE" "INFO" "Creating tag $new_version on branch $current_branch"
    
    # Create annotated tag
    git tag -a "$new_version" -m "Release $new_version"
    
    print_status "$GREEN" "SUCCESS" "Created tag $new_version"
    
    # Ask user if they want to push
    read -p "Push tag to origin? [y/N]: " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        print_status "$BLUE" "INFO" "Pushing tag to origin..."
        git push origin "$new_version"
        print_status "$GREEN" "SUCCESS" "Tag pushed to origin"
        print_status "$BLUE" "INFO" "GitHub Actions will now build and create a release"
    else
        print_status "$YELLOW" "WARNING" "Tag created locally but not pushed"
        print_status "$BLUE" "INFO" "Push later with: git push origin $new_version"
    fi
}

# Main function
main() {
    # Parse arguments
    case "${1:-}" in
        -h|--help)
            show_help
            exit 0
            ;;
        "")
            print_status "$RED" "ERROR" "Missing required argument"
            echo "Usage: $0 <major|minor>"
            echo "Use '$0 --help' for more information"
            exit 1
            ;;
        major|minor)
            local bump_type="$1"
            ;;
        *)
            print_status "$RED" "ERROR" "Invalid argument: $1"
            echo "Usage: $0 <major|minor>"
            echo "Use '$0 --help' for more information"
            exit 1
            ;;
    esac
    
    print_status "$BLUE" "INFO" "PDF-FTS Version Release Script"
    
    # Check if we're in a git repository
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        print_status "$RED" "ERROR" "Not in a git repository"
        exit 1
    fi
    
    # Check git status
    check_git_status
    
    # Get current version
    local current_version
    current_version=$(get_latest_version)
    print_status "$BLUE" "INFO" "Current version: $current_version"
    
    # Generate new version
    local new_version
    new_version=$(generate_new_version "$bump_type" "$current_version")
    print_status "$BLUE" "INFO" "New version: $new_version"
    
    # Confirm with user
    read -p "Create and tag version $new_version? [y/N]: " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_status "$YELLOW" "INFO" "Cancelled by user"
        exit 0
    fi
    
    # Create tag
    create_tag "$new_version"
    
    print_status "$GREEN" "SUCCESS" "Version $new_version release process completed!"
}

# Run main function
main "$@"
